<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IOrderService" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://orders.acme.example/OrderService.svc" binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IOrderService"
                contract="Acme.Orders.Contracts.IOrderService" name="BasicHttpBinding_IOrderService" />
    </client>
  </system.serviceModel>
</configuration>
