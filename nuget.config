<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Groma is private: restoring it needs a GitHub token with read:packages. -->
    <add key="github-avmcclure" value="https://nuget.pkg.github.com/avmcclure/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="github-avmcclure"><package pattern="Groma" /></packageSource>
  </packageSourceMapping>
</configuration>
