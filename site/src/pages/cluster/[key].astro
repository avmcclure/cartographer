---
// Cluster pages are now lanes on the map; an old link lands on its lane.
import { map, clusterHref } from '../../lib/data.js';
export function getStaticPaths() {
  return map.clusters.map((c) => ({ params: { key: c.key } }));
}
const to = clusterHref(Astro.params.key);
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0; url=${to}`} /><title>Moved to the map</title></head>
  <body><p>This cluster is now a lane on the map: <a href={to}>open it there</a>.</p></body>
</html>
