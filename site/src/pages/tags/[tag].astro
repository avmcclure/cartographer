---
// One data tag: the tables that carry it, the clusters they sit in, and what reads or writes each.
import Base from '../../layouts/Base.astro';
import Basis from '../../components/Basis.astro';
import Evidence from '../../components/Evidence.astro';
import { tags, map, colourOf, entry as readEntry, entryHref, clusterHref, kindLabel, plural } from '../../lib/data.js';
export function getStaticPaths() {
  return tags.map((t) => ({ params: { tag: t.name } }));
}
const tag = tags.find((t) => t.name === Astro.params.tag);
const clusters = tag.clusters.map((key) => ({ c: map.clusters.find((c) => c.key === key), color: colourOf(key) }));
const touching = tag.tables.map((t) => ({ ...t, usedBy: (readEntry(t.entry.id).usedBy ?? []).filter((l) => l.type === 'reads' || l.type === 'writes') }));
const users = new Set(touching.flatMap((t) => t.usedBy.map((l) => l.from.id)));
---
<Base title={`Data tag ${tag.name}`}>
  <article class="page">
    <p class="kicker">Data tag</p>
    <h1>{tag.name}</h1>
    <p class="lede">{plural(tag.tables.length, 'table')} tagged {tag.name}, read or written by {plural(users.size, 'part')}.</p>
    {clusters.length > 0 && (
      <section>
        <h2 class="cap">In {plural(clusters.length, 'cluster')}</h2>
        <div class="chips">{clusters.map(({ c, color }) => <a class="chip" href={clusterHref(c.key)}><span class="dot" style={`background:var(--c${color})`}></span>{c.name}</a>)}</div>
      </section>
    )}
    {touching.map((t) => (
      <section class="sec">
        <h2 class="cap"><a href={entryHref(t.entry.id)}>{t.entry.name}</a></h2>
        <p class="small"><Basis basis={t.basis} /><Evidence basis={t.basis} evidence={t.evidence} /></p>
        {t.usedBy.length ? (
          <ul class="rows">
            {t.usedBy.map((l) => (
              <li><Basis basis={l.basis} /><span>{l.type === 'reads' ? 'Read by' : 'Written by'} <a href={entryHref(l.from.id)}>{l.from.name}</a> <span class="small">{kindLabel(l.from)}</span><span class="what"><Evidence basis={l.basis} evidence={l.evidence} /></span></span></li>
            ))}
          </ul>
        ) : <p class="small">Nothing is known to read or write it.</p>}
      </section>
    ))}
  </article>
</Base>
