---
// The map: every part, in lanes by cluster (ADR 1), with data flowing left to right.
import Base from '../layouts/Base.astro';
import { map, lanes as order, entryHref, percent, plural, json } from '../lib/data.js';
import { columns, loopsBack } from '../lib/flow.js';
const col = columns(map);
const byKey = new Map(map.clusters.map((c) => [c.key, c]));
const lanes = order.map((key, i) => ({ key, name: byKey.get(key).name, pinned: byKey.get(key).pinned, color: i, count: byKey.get(key).members.length }));
const parts = order.flatMap((key) => byKey.get(key).members.map((m) => ({ id: m.id, name: m.name, kind: m.kind === 'external' ? 'external system' : m.kind, type: m.type, role: m.role, roleBasis: m.roleBasis, readers: m.readers, lane: key, col: col.get(m.id), found: m.found, href: entryHref(m.id) })))
  .sort((a, b) => order.indexOf(a.lane) - order.indexOf(b.lane) || a.col - b.col || a.name.localeCompare(b.name));
const data = { lanes, parts, links: map.parts.map(({ from, to, call, count, basis, verbs, over, ops, forwards, back }) => ({ from, to, call, count, basis, verbs, over, ops, forwards, back })) };
// Links by transport, most first; links with none recorded last.
// A forward drawn both ways (written through and read back) is one link: count it once.
const twin = loopsBack(map);
const transports = Object.entries(Object.groupBy(map.parts.filter((l) => !twin(l)).flatMap((l) => (l.over?.length ? l.over : [{ how: '', count: l.count }])), (o) => o.how))
  .map(([how, list]) => ({ how, count: list.reduce((s, o) => s + o.count, 0) }))
  .sort((a, b) => (a.how === '') - (b.how === '') || b.count - a.count || a.how.localeCompare(b.how));
const hasRole = (r) => parts.some((p) => p.role === r);
const s = map.suggestion;
const goneTo = (name) => {
  const to = Object.entries(Object.groupBy(s.moved.filter((m) => m.from === name), (m) => m.to)).sort((a, b) => b[1].length - a[1].length).map(([t]) => t);
  return to.length === 1 ? `join ${to[0]}` : `split between ${to.slice(0, -1).join(', ')} and ${to.at(-1)}`;
};
---
<Base title="Map" wide>
  {s && (
    <div class="notice" role="note">
      <p>
        The links have changed since these clusters were pinned. Regrouping would keep <strong>{percent(s.inside)}</strong> of links inside a cluster, up from {percent(map.inside)}.
        {' '}{[...s.gone.map((g) => `${g} would ${goneTo(g)}`), ...s.moved.filter((m) => !s.gone.includes(m.from)).map((m) => `${m.part.name} would move from ${m.from} to ${m.to}`)].join('; ')}.
      </p>
      <p class="small">To regroup, run <code>cartographer clusters regroup</code> in the atlas and rebuild the site.</p>
    </div>
  )}
  <div class="key small" aria-label="Key">
    <span><svg width="30" height="10" aria-hidden="true"><path d="M0 5 H24" stroke="currentColor" stroke-width="1.6" /><path d="M22 1 L30 5 L22 9 z" fill="currentColor" /></svg>data flows this way</span>
    <span><svg width="30" height="10" aria-hidden="true"><path d="M0 5 H30" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2 4" /></svg>calls</span>
    <span><svg width="30" height="10" aria-hidden="true"><path d="M0 5 H30" stroke="currentColor" stroke-width="1.6" opacity="0.35" /></svg>inferred, not read from code</span>
    {hasRole('pass-through') && <span><svg width="24" height="14" aria-hidden="true"><polygon points="5,1 19,1 23,7 19,13 5,13 1,7" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>pass-through</span>}
    {hasRole('lookup') && <span><svg width="24" height="14" aria-hidden="true"><rect x="1" y="1" width="22" height="12" rx="6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>lookup, read from but never fed</span>}
    <span><span class="swatch" style="background:var(--up)"></span>feeds the selected part</span>
    <span><span class="swatch" style="background:var(--accent)"></span>fed by it</span>
    <label class="toggle"><input type="checkbox" id="cross" checked={parts.length <= 80} /> Links between clusters</label>
    <label class="toggle" style="margin-left:0"><input type="checkbox" id="calls" checked /> Calls</label>
  </div>
  {transports.length > 1 && (
    <div class="transports small" role="group" aria-label="Show links by what they travel over. A link between two parts that travels over several stays while any of them is on.">
      <span title="A link between two parts that travels over several stays while any of them is on.">Over</span>
      {transports.map((t) => <button type="button" class="chip" data-how={t.how} aria-pressed="true">{t.how || 'not recorded'}<span class="n">{t.count}</span></button>)}
    </div>
  )}
  <div class="workspace">
    <section class="stage" aria-label="Data flow map">
      <svg class="map" id="map" role="group" aria-label="Every part, in lanes by cluster, with data flowing left to right. The list beside it has the same clusters and parts."></svg>
      <noscript><p>The drawing needs JavaScript. Every cluster and its parts are listed beside it.</p></noscript>
      <p class="hint">Select a part to follow its data · select a lane's name to open or close it · drag to pan, scroll to zoom</p>
    </section>
    <aside class="panel" id="panel">
      <div id="resting">
        <div>
          <p class="cap">Data flow</p>
          <h2>{plural(lanes.length, 'cluster')}, {plural(parts.length, 'part')}</h2>
        </div>
        <p style="margin-top:8px">Each lane is a cluster of parts that work together. Arrows follow the data, from where it is written or published to where it is read or consumed: upstream is to the left, downstream to the right. {map.links ? `${percent(map.inside)} of ${plural(map.links, 'link')} stay inside a cluster.` : 'No links between parts yet.'} Code dependencies and owners play no part.</p>
        {hasRole('lookup') && <p>Lookups, such as a pricing or identity service, are only ever read from. They sit in a band at the top of their lane. Each part that reads one shows a dot; the lines appear when a selected part's trace runs through them.</p>}
        {hasRole('pass-through') && <p>Pass-throughs, such as a gateway in front of an old and a new API, relay requests unchanged. They sit in the flow between their callers and what they forward to.</p>}
        <p class="cap" style="margin-top:16px">Clusters, top to bottom</p>
        {lanes.map((l) => (
          <details class="lane-list" id={`lane-${l.key}`}>
            <summary><span class="dot" style={`background:var(--c${l.color % 8})`}></span>{l.name}{l.pinned && <span class="pinned" style="margin-left:8px">pinned</span>}<span class="n">{l.count}</span></summary>
            <ul class="rows plain">
              {parts.filter((p) => p.lane === l.key).map((p) => <li><a href={p.href} data-part={p.id}>{p.name}</a><span class="n">{p.kind}</span></li>)}
            </ul>
          </details>
        ))}
      </div>
    </aside>
  </div>
  <template id="part-panel">
    <div><p class="cap" data-kind></p><h2 data-name aria-live="polite"></h2></div>
    <p><a class="button" data-open>Open its page</a> <a href="#" data-clear style="margin-left:10px">Clear</a></p>
    <p class="role-note" data-role hidden></p>
    <p data-summary></p>
    <div class="steps" role="group" aria-label="How far to follow the data"><span class="small">Follow</span></div>
    <div><p class="cap">Upstream: data comes from</p><ul class="rows plain" data-from></ul></div>
    <div><p class="cap">Downstream: data goes to</p><ul class="rows plain" data-to></ul></div>
    <div data-looks-block><p class="cap" data-looks-title>Looks up</p><ul class="rows plain" data-looks></ul></div>
    <div data-calls-block><p class="cap">Calls</p><ul class="rows plain" data-calls></ul></div>
  </template>
  <script type="application/json" id="map-data" set:html={json(data)} />
  <script>
    import { createMap, readFromLookup, onlyReadFromLookup } from '../scripts/map.js';
    const svg = document.getElementById('map');
    const panel = document.getElementById('panel');
    const resting = document.getElementById('resting');
    const data = JSON.parse(document.getElementById('map-data').textContent);
    const part = new Map(data.parts.map((p) => [p.id, p]));
    const lane = new Map(data.lanes.map((l) => [l.key, l]));

    function row(id, note) {
      const p = part.get(id);
      const li = document.createElement('li');
      const a = Object.assign(document.createElement('a'), { href: p.href, textContent: p.name });
      a.addEventListener('click', (e) => { e.preventDefault(); map.focus(id); });
      const span = document.createElement('span');
      span.append(a, Object.assign(document.createElement('span'), { className: 'what', textContent: note }));
      const dot = Object.assign(document.createElement('span'), { className: 'dot', title: lane.get(p.lane).name });
      dot.style.background = `var(--c${lane.get(p.lane).color % 8})`;
      li.append(span, dot);
      return li;
    }
    // "writes 2 over http · POST /orders, GET /orders/{id} · inferred"
    // Where a role an entry sets came from; a role worked out from links says nothing.
    const said = (p) => ({ stated: ' A person stated this role.', inferred: ' An agent inferred this role from the code.', extracted: ' This role was read from the code.' })[p.roleBasis] ?? '';
    const verbs = (l) => [
      l.verbs.map((v) => `${v.verb} ${v.count}`).join(', ') + (l.over?.some((o) => o.how) ? ` over ${l.over.map((o) => o.how).filter(Boolean).join(', ')}` : ''),
      l.ops?.length ? l.ops.slice(0, 3).join(', ') + (l.ops.length > 3 ? ` and ${l.ops.length - 3} more` : '') : null,
      l.basis === 'inferred' ? 'inferred' : null,
    ].filter(Boolean).join(' · ');


    function show(id, down, up) {
      if (!id) { panel.replaceChildren(resting); return; }
      const p = part.get(id), view = document.getElementById('part-panel').content.cloneNode(true);
      view.querySelector('[data-kind]').textContent = `${p.type && p.type !== p.kind ? `${p.kind} · ${p.type}` : p.kind} · ${lane.get(p.lane).name}`;
      view.querySelector('[data-name]').textContent = p.name;
      view.querySelector('[data-open]').href = p.href;
      view.querySelector('[data-clear]').addEventListener('click', (e) => { e.preventDefault(); map.clear(); });
      const far = map.depth === Infinity ? '' : ` within ${map.depth} step${map.depth === 1 ? '' : 's'}`;
      view.querySelector('[data-summary]').textContent = `${up.parts.size} part${up.parts.size === 1 ? '' : 's'} feed it and its data reaches ${down.parts.size}${far}.${p.found ? ` Found in ${p.found}.` : ''}`;
      const steps = view.querySelector('.steps');
      for (const [n, label] of [[1, '1 step'], [2, '2 steps'], [3, '3 steps'], [Infinity, 'all the way']]) {
        const b = Object.assign(document.createElement('button'), { type: 'button', textContent: label });
        b.setAttribute('aria-pressed', String(map.depth === n));
        b.addEventListener('click', () => { map.steps(n); panel.querySelector(`.steps button:nth-of-type(${[1, 2, 3, Infinity].indexOf(n) + 1})`)?.focus(); });
        steps.append(b);
      }
      const links = map.links;
      // A lookup's readers, and the lookups a part reads, are listed on their own: they sit beside the flow.
      const looks = links.filter((l) => readFromLookup(l, part) && (p.role === 'lookup' ? l.from === id : l.to === id));
      // A link that also carries something other than a read is listed in the flow too.
      const besides = (l) => !onlyReadFromLookup(l, part);
      const from = links.filter((l) => !l.call && l.to === id && besides(l)), to = links.filter((l) => !l.call && l.from === id && besides(l)), calls = links.filter((l) => l.call && (l.from === id || l.to === id));
      const empty = (t) => Object.assign(document.createElement('li'), { className: 'small', textContent: t });
      view.querySelector('[data-from]').append(...(from.length ? from.map((l) => row(l.from, verbs(l))) : [empty('Nothing: its data starts here.')]));
      view.querySelector('[data-to]').append(...(to.length ? to.map((l) => row(l.to, verbs(l))) : [empty(p.role === 'lookup' ? 'Nothing besides the parts that read it.' : 'Nothing: its data ends here.')]));
      if (looks.length) {
        view.querySelector('[data-looks-title]').textContent = p.role === 'lookup' ? 'Read by' : 'Looks up';
        view.querySelector('[data-looks]').append(...looks.map((l) => row(p.role === 'lookup' ? l.to : l.from, verbs(l))));
      } else view.querySelector('[data-looks-block]').remove();
      const note = view.querySelector('[data-role]');
      if (p.role === 'pass-through') {
        // Its own forwards run out from it, or back into it when data is read through; a forward from an outer
        // pass-through makes that one a caller.
        const onward = (l) => !!l.forwards && ((l.from === id && !l.back) || (l.to === id && l.back));
        const mine = links.filter((l) => !l.call && (l.from === id || l.to === id)), other = (l) => part.get(l.from === id ? l.to : l.from).name;
        const onto = [...new Set(mine.filter(onward).map(other))], callers = [...new Set(mine.filter((l) => !onward(l)).map(other))];
        const list = (names) => (names.length > 3 ? `${names.slice(0, 3).join(', ')} and ${names.length - 3} more` : names.join(', '));
        note.textContent = `Pass-through: relays requests from ${list(callers) || 'its callers'} to ${list(onto) || 'what it forwards to'} unchanged.${said(p)}`;
        note.hidden = false;
      } else if (p.role === 'lookup') {
        const n = p.readers ?? looks.length;
        note.textContent = `Lookup: read by ${n} part${n === 1 ? '' : 's'}${p.roleBasis ? '' : ', with its own data coming only from databases'}, so it sits beside the flow.${said(p)}`;
        note.hidden = false;
      }
      if (calls.length) view.querySelector('[data-calls]').append(...calls.map((l) => row(l.from === id ? l.to : l.from, l.from === id ? `called by this part · ${verbs(l)}` : `calls this part · ${verbs(l)}`)));
      else view.querySelector('[data-calls-block]').remove();
      panel.replaceChildren(view);
    }

    const map = createMap(svg, data, { onSelect: show });
    for (const a of resting.querySelectorAll('[data-part]')) a.addEventListener('click', (e) => { e.preventDefault(); map.focus(a.dataset.part); });
    for (const d of resting.querySelectorAll('details')) d.addEventListener('toggle', () => { if (d.open) map.lane(d.id.slice(5)); });
    // Large maps start with links between clusters hidden; a selected part's trace always shows the ones it uses.
    const cross = document.getElementById('cross');
    svg.classList.toggle('no-cross', !cross.checked);
    cross.addEventListener('change', () => svg.classList.toggle('no-cross', !cross.checked));
    document.getElementById('calls').addEventListener('change', (e) => svg.classList.toggle('no-calls', !e.target.checked));
    const chips = [...document.querySelectorAll('.transports .chip')];
    for (const c of chips) c.addEventListener('click', () => {
      c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
      map.transports(chips.filter((x) => x.getAttribute('aria-pressed') === 'false').map((x) => x.dataset.how));
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !e.target.closest('input, textarea, select')) map.clear(); });

    // #p=<part>[&d=<steps>|all] traces a part; #c=<cluster> brings its lane into view.
    function follow() {
      const params = new URLSearchParams(location.hash.slice(1));
      const [k, v] = params.has('p') ? ['p', params.get('p')] : params.has('c') ? ['c', params.get('c')] : [];
      const d = params.get('d');
      if (k === 'p' && v) map.focus(v, d === 'all' ? Infinity : Number(d) || undefined);
      if (k === 'c' && v) { map.lane(v); resting.querySelector(`#lane-${CSS.escape(v)}`)?.setAttribute('open', ''); }
    }
    follow();
    window.addEventListener('hashchange', follow);
  </script>
</Base>
