---
// The engineers' front door: every entry, A to Z, with where it is on the plans.
import Base from '../layouts/Base.astro';
import { gazetteer, entryHref, sheetHref, sheetNumber, kindLabel, date } from '../lib/data.js';
const rows = [...gazetteer].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }) || a.id.localeCompare(b.id));
const letter = (e) => (/^[a-z]/i.test(e.name) ? e.name[0].toUpperCase() : '#');
const letters = [...new Set(rows.map(letter))];
const firstOf = new Map(letters.map((l) => [l, rows.find((e) => letter(e) === l).id]));
---
<Base title="Gazetteer" wide>
  <div class="sheet">
    <header class="sheet-title"><h1>Gazetteer</h1><p class="sheet-no">{rows.length} entries, A to Z</p></header>
    <div class="filter">
      <label for="q">Find an entry</label>
      <input id="q" type="search" placeholder="Name, kind or ID" autocomplete="off" />
      <span id="found" class="small" aria-live="polite"></span>
    </div>
    <nav class="letters" aria-label="Letters">{letters.map((l) => <a href={`#l-${l}`}>{l}</a>)}</nav>
    <div class="scroll">
      <table id="gazetteer">
        <thead><tr><th>Name</th><th>Kind</th><th>Summary</th><th>Sheet</th><th>Plot</th><th>Grid</th><th class="n">Unsurveyed</th><th>Last verified</th></tr></thead>
        <tbody>
          {rows.map((e) => (
            <tr id={firstOf.get(letter(e)) === e.id ? `l-${letter(e)}` : undefined} data-text={`${e.name} ${kindLabel(e)} ${e.id}`.toLowerCase()}>
              <td><a class="select" href={entryHref(e.id)}>{e.name}</a>{e.status === 'retired' && <span class="flag">retired</span>}<br /><span class="id">{e.id}</span></td>
              <td>{kindLabel(e)}</td>
              <td class="summary">{e.summary}</td>
              <td>{e.sheet && <a href={`${sheetHref(e.sheet)}?sel=${encodeURIComponent(e.id)}`} data-keep>Sheet {sheetNumber(e.sheet)}</a>}</td>
              <td>{e.number}</td>
              <td>{e.ref}</td>
              <td class="n">{e.unsurveyed || ''}</td>
              <td>{date(e.verified)}{e.stale && <span class="flag">long unverified</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <script>
    document.documentElement.classList.add('js');
    const input = document.getElementById('q');
    const rows = [...document.querySelectorAll('#gazetteer tbody tr')];
    const found = document.getElementById('found');
    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let n = 0;
      for (const row of rows) {
        row.hidden = !words.every((w) => row.dataset.text.includes(w));
        if (!row.hidden) n++;
      }
      found.textContent = words.length ? `${n} of ${rows.length}` : '';
    });
  </script>
</Base>
