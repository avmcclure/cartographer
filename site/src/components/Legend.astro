---
import Basis from './Basis.astro';
const { level } = Astro.props;
---
<section class="legend" aria-labelledby="legend-h">
  <h2 class="cap" id="legend-h">Legend</h2>
  <dl>
    {level === 'organisation' && <div><dt><svg width="36" height="14"><rect class="sw k-system" x="4" y="1" width="28" height="12" /></svg></dt><dd>System</dd></div>}
    {level === 'organisation' && <div><dt><svg width="36" height="14"><rect class="sw k-unassigned" x="4" y="1" width="28" height="12" /></svg></dt><dd>Parts not yet placed in a system</dd></div>}
    {level !== 'organisation' && <div><dt><svg width="36" height="14"><rect class="sw k-component" x="4" y="1" width="28" height="12" /></svg></dt><dd>Repository, component</dd></div>}
    {level !== 'organisation' && <div><dt><svg width="36" height="14"><rect class="sw k-database" x="4" y="1" width="28" height="12" /></svg></dt><dd>Database, table, view</dd></div>}
    {level !== 'organisation' && <div><dt><svg width="36" height="14"><rect class="sw k-routine" x="4" y="1" width="28" height="12" /></svg></dt><dd>Routine, trigger</dd></div>}
    <div><dt><svg width="36" height="14"><rect class="sw k-channel" x="4" y="1" width="28" height="12" /><path d="M8 1 V13 M28 1 V13" stroke="#111" fill="none" /></svg></dt><dd>Channel: a queue, topic or file drop</dd></div>
    <div><dt><svg width="36" height="14"><defs><pattern id="hatch-key" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="#111" stroke-width=".7" /></pattern></defs><rect x="4" y="1" width="28" height="12" fill="url(#hatch-key)" stroke="#111" /><rect x="8" y="4" width="20" height="6" fill="#fff" /></svg></dt><dd>External system</dd></div>
    <div><dt><svg width="36" height="14"><rect class="sw k-retired" x="4" y="1" width="28" height="12" /><line x1="8" y1="7" x2="28" y2="7" stroke="#555" /></svg></dt><dd>Retired: gone, kept so links resolve</dd></div>
    <div><dt><svg width="36" height="16"><g class="sign" transform="translate(7 0)"><rect width="22" height="16" /><text x="11" y="12" text-anchor="middle">?2</text></g></svg></dt><dd>Unsurveyed: open questions, with their number</dd></div>
    <div><dt><svg width="36" height="16"><g class="sign" transform="translate(7 0)"><rect width="22" height="16" /><text x="11" y="12" text-anchor="middle">≠</text></g></svg></dt><dd>Drift: two sources disagree</dd></div>
    <div><dt><Basis basis="extracted" /></dt><dd>Extracted: read from a file or catalogue</dd></div>
    <div><dt><Basis basis="inferred" /></dt><dd>Inferred by an agent, at least in part</dd></div>
    <div><dt><Basis basis="stated" /></dt><dd>Stated by a person, at least in part</dd></div>
    <div><dt><svg width="36" height="14"><rect class="sw sel-origin" x="4" y="1" width="28" height="12" /></svg></dt><dd>The selection</dd></div>
    <div><dt><svg width="36" height="14"><rect class="sw sel-reached" x="4" y="1" width="28" height="12" /></svg></dt><dd>What it uses, and what uses it</dd></div>
  </dl>
  <p class="small">{level === 'organisation' ? 'The number on a line is how many links cross between the two plots.' : 'A line stands for every link between two plots, counted by kind. Each link is in the links schedule.'}</p>
</section>
