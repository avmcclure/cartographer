---
// A plan with everything that goes under it: statement of the selection, schedule, links schedule, legend, adjoining sheets.
import Base from '../layouts/Base.astro';
import Plan from './Plan.astro';
import Locator from './Locator.astro';
import Legend from './Legend.astro';
import Basis from './Basis.astro';
import Evidence from './Evidence.astro';
import { site, sheet as readSheet, sheetHref, entryHref, sheetNumber, href } from '../lib/data.js';

const { sheet } = Astro.props;
const number = (p) => p.number.split('/').map(Number);
const plots = [...sheet.plots].sort((a, b) => number(a)[0] - number(b)[0] || (number(a)[1] ?? 0) - (number(b)[1] ?? 0));
const levelName = { organisation: 'Organisation', system: 'System', area: 'Area' }[sheet.level];
const up = sheet.up ? site.sheets.find((s) => s.id === sheet.up) : null;
const upUp = up?.up ? site.sheets.find((s) => s.id === up.up) : null;
const beyond = [...new Map(sheet.lines.filter((l) => l.beyondSheet).map((l) => [l.beyondSheet, l.beyond])).entries()];
const below = plots.filter((p) => p.opens && !p.neighbour);
const elsewhere = plots.filter((p) => p.opens && p.neighbour);
const label =
  `Plan of ${sheet.title}, ${levelName.toLowerCase()} sheet. ${sheet.plots.length} plots: ` +
  plots.filter((p) => !p.parent).map((p) => `${p.number} ${p.name}`).join(', ') +
  `. ${sheet.lines.length} lines. The schedule below lists every plot and is the same information as a table.`;
const client = {
  id: sheet.id,
  subject: sheet.subject ?? null,
  where: sheet.where,
  lines: sheet.lines.map((l) => ({ id: l.id, pairs: l.pairs })),
  routes: sheet.routes,
  plots: Object.fromEntries(sheet.plots.map((p) => [p.id, { name: p.name, number: p.number, entry: p.entry ?? null, opens: p.opens ? sheetHref(p.opens) : null, page: p.entry ? entryHref(p.entry) : null }])),
};
---
<Base title={sheet.level === 'organisation' ? 'Index of sheets' : sheet.title} wide>
  <div class="sheet" data-sheet={sheet.id}>
    <header class="sheet-title">
      <div>
        <nav class="scale" aria-label="Scale">
          <a href={sheetHref('organisation')} aria-current={sheet.level === 'organisation' ? 'page' : undefined}>Organisation</a>
          {sheet.level === 'system' && <a href={sheetHref(sheet.id)} aria-current="page">System</a>}
          {sheet.level === 'area' && up && up.level === 'system' && <a href={sheetHref(up.id)}>System: {up.title}</a>}
          {sheet.level === 'area' && <a href={sheetHref(sheet.id)} aria-current="page">Area</a>}
        </nav>
        <h1>{sheet.title}</h1>
      </div>
      <p class="sheet-no">{site.organisation} atlas · {levelName} sheet · Sheet {sheetNumber(sheet.id)} of {site.sheets.length}</p>
    </header>

    {sheet.unplaced && (
      <p class="warning">
        This sheet needs a re-survey: {sheet.unplaced.length ? `${sheet.unplaced.join(', ')} could not be placed without moving plots that are already here, and ${sheet.unplaced.length === 1 ? 'is' : 'are'} missing from the drawing.` : 'a plot grew and no longer fits where it was.'}
        Run <code>cartographer plan resurvey {sheet.id}</code>.
      </p>
    )}
    {sheet.note && <p class="warning">{sheet.note}</p>}

    <section class="statement" id="statement" aria-live="polite" aria-label="Selection">
      <p class="statement-text">Nothing is selected. Select a plot on the plan, or a row of the schedule, to see what it uses and what uses it.</p>
    </section>

    <div class="plan-frame">
      <div class="plan-view" tabindex="0" role="region" aria-label={`${sheet.title} plan. Scroll to pan.`}>
        {sheet.plots.length ? <Plan sheet={sheet} label={label} /> : <p class="empty">Nothing has been surveyed on this sheet yet.</p>}
      </div>
      {sheet.plots.length > 0 && <div class="plan-locator" title="Where the view is on the sheet"><Locator sheet={sheet} width={150} /></div>}
    </div>

    <section class="schedule" aria-labelledby="schedule-h">
      <h2 class="cap" id="schedule-h">Schedule for sheet {sheetNumber(sheet.id)} · {sheet.plots.length} plots</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr><th>No.</th><th>Name</th><th>Kind</th><th>Grid</th><th>Summary</th><th class="n">Parts</th><th class="n">Uses</th><th class="n">Used by</th><th class="n">Unsurveyed</th><th>Selection</th><th>Open</th></tr>
          </thead>
          <tbody>
            {plots.map((p) => (
              <tr data-plot={p.id} class={`${p.parent ? 'part' : ''}${p.neighbour ? ' neighbour' : ''}`}>
                <td>{p.number}</td>
                <td><a class="select" href={`?sel=${encodeURIComponent(p.id)}`} data-select={p.id}>{p.name}</a>{p.retired && <span class="flag"> retired</span>}{p.drift && <span class="flag"> drift</span>}</td>
                <td>{p.kind === 'external' ? 'external system' : p.type ? `${p.kind} · ${p.type}` : p.kind}{p.neighbour ? ` (outside this ${sheet.level})` : ''}{p.provisional ? ' (provisional)' : ''}</td>
                <td>{p.ref}</td>
                <td class="summary">{p.summary}</td>
                <td class="n">{p.parts || ''}</td>
                <td class="n">{p.uses}</td>
                <td class="n">{p.usedBy}</td>
                <td class="n">{p.unsurveyed || ''}</td>
                <td class="selcell" data-selcell></td>
                <td class="open">
                  {p.opens && <a href={sheetHref(p.opens)}>Sheet {sheetNumber(p.opens)}</a>}
                  {p.opens && p.entry && ' · '}
                  {p.entry && <a href={entryHref(p.entry)}>Entry</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {sheet.level === 'organisation' ? (
      <section class="schedule" aria-labelledby="crossing-h">
        <h2 class="cap" id="crossing-h">Links that cross · {sheet.lines.reduce((n, l) => n + l.total, 0)} links on {sheet.lines.length} lines</h2>
        <div class="scroll">
          <table>
            <thead><tr><th>From</th><th>To</th><th class="n">Links</th><th>Of which</th><th>Known by</th></tr></thead>
            <tbody>
              {sheet.lines.map((l) => (
                <tr data-line={l.id}>
                  <td>{client.plots[l.from]?.name}</td><td>{client.plots[l.to]?.name}</td><td class="n">{l.total}</td>
                  <td>{l.verbs.map((v) => `${v.verb} ${v.count}`).join(', ')}</td>
                  <td><Basis basis={l.basis} /> {l.basis === 'inferred' ? 'inferred, at least in part' : l.basis}{l.stated && l.basis !== 'stated' ? '; some stated by a person' : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <details class="schedule links" open={sheet.links.length <= 80}>
        <summary class="cap">Links schedule · {sheet.links.length} links</summary>
        <div class="scroll">
          <table>
            <thead><tr><th>From</th><th>Verb</th><th>To</th><th>Known by</th></tr></thead>
            <tbody>
              {sheet.links.map((l) => (
                <tr data-from={l.from} data-to={l.to}>
                  <td><a href={entryHref(l.from)}>{l.fromName}</a></td>
                  <td>{l.verb}</td>
                  <td><a href={entryHref(l.to)}>{l.toName}</a></td>
                  <td><Basis basis={l.basis} /> <Evidence basis={l.basis} evidence={l.evidence} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )}

    <div class="margin">
      <Legend level={sheet.level} />
      <section class="adjoining" aria-labelledby="adjoining-h">
        <h2 class="cap" id="adjoining-h">Adjoining sheets</h2>
        <ul>
          {up && <li>Up: <a href={sheetHref(up.id)}>Sheet {sheetNumber(up.id)}, {up.level === 'organisation' ? 'the organisation' : up.title}</a></li>}
          {beyond.map(([id, name]) => <li>Across: <a href={sheetHref(id)}>Sheet {sheetNumber(id)}, {name}</a></li>)}
          {elsewhere.map((p) => <li>Across: <a href={sheetHref(p.opens)}>Sheet {sheetNumber(p.opens)}, {p.name}</a></li>)}
          {below.map((p) => <li>Down: <a href={sheetHref(p.opens)}>Sheet {sheetNumber(p.opens)}, {p.name}</a></li>)}
          {sheet.level === 'area' && sheet.subject && <li>Entry: <a href={entryHref(sheet.subject)}>{sheet.title}</a></li>}
        </ul>
      </section>
    </div>
  </div>
  <script type="application/json" id="sheet-data" set:html={JSON.stringify(client).replace(/</g, '\\u003c')}></script>
  <script>
    import '../scripts/plan.js';
  </script>
</Base>
